<!DOCTYPE html>
<html>

<head>
    <title>My Delivery Tracker</title>
    <Style>
        body {
            font-family: Arial, sans-serif;
            background: aliceblue;
            text-align: center;
            padding: 30px;
        }

        h1 {
            color: #ff5a43;

        }

        button {
            background-color: #ff5a43;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 10px 25px;
            margin: 5px;
            cursor: pointer;
        }

        div {
            border: 1px solid #ff5a43;
            border-radius: 6px;
            padding: 8px 12px;
            margin: 6px auto;
            text-align: left;
            width: 200px;
        }
        </style>
</head>
<body>
    <h1>My Delivery Tracker</h1>
    <button onclick= "saveOrder()">Save Order</button>
    <button onclick="startDelivery()">Start Delivery</button>

    <div>JSON Text: <span id="jsonText"></span></div>
    <div> Loaded items: <span id="loadedItems"></span></div>
    <div>Loaded price: <span id="loadPrice"></span></div>
    <div>Status: <span id="status"></span></div>
    <div>result: <span id="result"></span></div>
    <script>

        // JSON - the order stored as a JavaScript object
        let order = {
            item: "Pizza",
            price: 5,
            shop:"My snack shop",

        };

        // JSON.stringify() and JSON.parse()
        function saveOrder() {
            let jsonText = JSON.stringify(order);
            let loadedOrder = JSON.parse(jsonText);
            document.getElementById("jsonText").innerHTML = jsonText;
            document.getElementById("loadedItems").innerHTML = loadedOrder.item;
            document.getElementById("loadPrice").innerHTML = loadedOrder.price;
        }
        // delay() - waits ms milliseconds - do not change this
        function delay(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }
        // async and await - track the delivery step by step
        async function startDelivery() {
            document.getElementById("status").innerHTML = "Order received";
            await delay(2000);
            document.getElementById("status").innerHTML = "Preparing your order";
            await delay(2000);
            document.getElementById("status").innerHTML = "Order is on the way";
            await delay(2000);
            document.getElementById("status").innerHTML = "Order delivered";
            document.getElementById("result").innerHTML = "Enjoy your meal!";
        }
        </script>
</body>
</html>


        


